{% extends 'base.html.twig' %}

{% block title %}Produits{% endblock %}

{% block body %}
    <h1 class="h3 mb-4">Produits</h1>

    {% if products is empty %}
        <p class="text-muted">Aucun produit pour le moment.</p>
    {% else %}
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
            {% for product in products %}
                <div class="col">
                    <div class="card h-100">
                        <img src="{{ product.image }}" alt="{{ product.title }}" class="card-img-top p-3" style="height: 200px; object-fit: contain;" loading="lazy">
                        <div class="card-body d-flex flex-column">
                            <p class="small text-muted mb-1">{{ product.category }}</p>
                            <h2 class="h6 card-title">{{ product.title }}</h2>
                            <p class="fw-semibold mt-auto mb-2">{{ product.price|number_format(2, ',', ' ') }} $</p>
                            <a href="{{ path('product_show', {id: product.id}) }}" class="btn btn-outline-primary btn-sm stretched-link">Voir le produit</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
